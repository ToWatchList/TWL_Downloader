# ToWatchList.com API Key (required)
TWL_API_KEY=your_api_key_here

# The local directory to save videos to.
# This is used by the 'run-local' make target.
# For the 'run' target, the download location is set by the volume mount in the Makefile.
TWL_DOWNLOAD_LOCATION=./videos

# Optional: Path to a Netscape format cookies file for YouTube.
# This allows downloading private or age-restricted videos.
# The file path should be the path *inside* the container (e.g., /config/cookies.txt).
YOUTUBE_COOKIES_FILE=

# Optional: Set to "true" to generate .nfo metadata files for Kodi
TWL_WRITE_NFO_FILES=true

# Optional: Comma-separated list of SponsorBlock categories to mark as chapters.
# See https://wiki.sponsor.ajay.app/w/Category_Types for a full list.
SPONSORBLOCK_CATEGORIES=sponsor,intro,outro,selfpromo,preview,music_offtopic

# Optional: Set to "true" to download to a temporary location before moving.
TWL_DOWNLOAD_TO_TMP=true

# Optional: Kodi connection details
# TWL_KODI_HOSTNAME=
# TWL_KODI_PORT=8080
# TWL_KODI_USER=
# TWL_KODI_PASSWORD=